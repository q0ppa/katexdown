# Maintainer: katexdown contributors
#
# Katexdown — katdown fork with KaTeX math, custom CSS, follow-mode panel and
# HTML export. This PKGBUILD builds straight from the parent directory of this
# file (i.e. the katexdown repository), no AUR entry needed:
#
#   cd katexdown/aur
#   makepkg -si
#
# If you publish the fork on GitHub later, point `url` at your repository and
# this PKGBUILD can be submitted to the AUR as-is (name: katexdown-git).

pkgname=katexdown-git
_pkgbase=katexdown
pkgver=0.2.0.r15.gea78249
pkgrel=1
pkgdesc="Markdown preview side panel for Kate with KaTeX math and custom CSS (katdown fork)"
arch=('x86_64')
url="https://github.com/uwuclxdy/katdown"
license=('GPL-3.0-or-later')
depends=('ktexteditor' 'syntax-highlighting' 'kxmlgui' 'kconfig' 'ki18n' 'kcoreaddons' 'qt6-base' 'qt6-webengine')
makedepends=('git' 'cmake' 'extra-cmake-modules')
provides=('katexdown')
conflicts=('katexdown')
# Build from the repository this PKGBUILD ships in (the aur/ parent dir).
# git+file clones only committed state; prepare() below overlays the actual
# working tree afterwards, so uncommitted changes are built too.
source=("$_pkgbase::git+file://${PWD%/*}")
sha256sums=('SKIP')

prepare() {
  # Make the build match what is in the repository right now (uncommitted
  # changes included). Skip bulky/dev dirs AND .git: the overlay is only
  # meant to refresh tracked file content. Copying .git over the makepkg
  # work copy rewrites its origin to the repository's real remote (e.g.
  # git@github.com:...) and its refs/reflog, so the NEXT makepkg run's
  # "updating working copy" git fetch would hit GitHub over SSH instead of
  # the local git+file source and fail (and it would silently build stale
  # refs on top of that). makepkg's own clone of the file:// source already
  # carries the committed state, so .git here can only ever hurt.
  cd "$srcdir/$_pkgbase"
  tar --exclude='./build*' --exclude='./runtime' --exclude='./aur' \
      --exclude='./.git' \
      -C "$startdir/.." -cf - . | tar -xf -
}

pkgver() {
  cd "$srcdir/$_pkgbase"
  if desc=$(git describe --long --tags 2>/dev/null); then
    printf '%s' "$desc" | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
  else
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

build() {
  cd "$srcdir/$_pkgbase"
  cmake -B build -S . \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  cd "$srcdir/$_pkgbase"
  DESTDIR="$pkgdir" cmake --install build
}

# To publish on the AUR later, regenerate with: makepkg --printsrcinfo > .SRCINFO
